{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=lamour.db"
  },
  "Jwt": {
    "Issuer": "LAmourApi",
    "Audience": "LAmourAdmin",
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION_ENV_VAR",
    "ExpiresMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Business": {
    "OpeningHour": 9,
    "ClosingHour": 21,
    "SlotIntervalMinutes": 30,
    "TimeZoneId": "SA Pacific Standard Time"
  }
}
